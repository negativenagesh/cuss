{
  "name": "cuss-studio",
  "version": "0.5.0",
  "private": true,
  "description": "CUSS (Cybernetic Umbilical Studio & Synth) — One-command launcher for Mac Cursor Bridge + Expo Go Mobile Deck",
  "scripts": {
    "start": "bash ./start-cuss.sh",
    "tunnel": "bash ./start-cuss.sh --tunnel",
    "service:install": "bash ./start-cuss.sh --install-service",
    "service:uninstall": "bash ./start-cuss.sh --uninstall-service",
    "menubar:install": "bash ./macos-menubar/build-menubar-app.sh",
    "test": "npm --prefix bridge test && ./bridge/node_modules/.bin/tsc -p bridge/tsconfig.json --noEmit && ./mobile/node_modules/.bin/tsc -p mobile/tsconfig.json --noEmit"
  }
}
